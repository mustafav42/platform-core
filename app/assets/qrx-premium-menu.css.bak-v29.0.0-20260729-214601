/* v3.1 admin customizer */
body.category-style-minimal .category-group{--category-tint:transparent!important}
body.category-style-minimal .category-trigger{background:var(--paper)}
body.category-style-accent .category-group{--category-tint:var(--gold)!important}
body.category-style-accent .category-trigger{background:linear-gradient(90deg,var(--gold) 0 9px,var(--paper) 9px)}
body.density-comfortable .product-row{padding-top:20px;padding-bottom:20px}
body.density-comfortable .product-thumb{width:82px;height:82px}
body.density-comfortable .product-row{grid-template-columns:82px 1fr 28px}
body.hide-product-images .product-row{grid-template-columns:1fr 28px}
body.hide-product-images .product-thumb{display:none!important}
@media(max-width:600px){body.density-comfortable .product-row{grid-template-columns:70px 1fr 18px}body.density-comfortable .product-thumb{width:70px;height:70px}body.hide-product-images .product-row{grid-template-columns:1fr 18px}}
/* QR Experience OS Studio v1.0 runtime controls */
.qrx-detail-media{min-height:var(--qrx-detail-image-height,360px)}
body.qrx-detail-centered-mode .qrx-detail-sheet{max-width:720px;max-height:88vh;border-radius:28px;margin:auto;inset:6vh auto auto;left:50%;transform:translateX(-50%)}
body.qrx-detail-fullscreen-mode .qrx-detail-sheet{inset:0;width:100%;max-width:none;max-height:none;height:100%;border-radius:0}
body.qrx-detail-fullscreen-mode .qrx-detail-media{min-height:min(52vh,var(--qrx-detail-image-height,420px))}
@media(max-width:700px){body.qrx-detail-centered-mode .qrx-detail-sheet{left:14px;right:14px;width:auto;transform:none;top:7vh}}

/* QR Experience OS v3.2.1 — category chevron collision hotfix */
.category-trigger{
  grid-template-columns:minmax(34px,48px) minmax(0,1fr) 44px;
  position:relative;
}
.category-title-wrap{
  min-width:0;
  max-width:100%;
  overflow:hidden;
  padding-right:2px;
}
.category-title-wrap strong,
.category-title-wrap small{
  max-width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.category-chevron{
  position:relative;
  z-index:2;
  flex:0 0 38px;
  min-width:38px;
  width:38px;
  height:38px;
  justify-self:end;
  align-self:center;
  margin-left:4px;
  background:var(--paper);
  pointer-events:none;
}
.category-chevron i{
  display:block;
  flex:none;
  transform-origin:center;
}
@media(max-width:600px){
  .category-trigger{
    grid-template-columns:minmax(30px,34px) minmax(0,1fr) 39px;
    column-gap:10px;
  }
  .category-title-wrap{
    padding-right:4px;
  }
  .category-chevron{
    min-width:36px;
    width:36px;
    height:36px;
    margin-left:0;
  }
}

/* QR Experience OS v3.2.2 — category title width hotfix */
.category-trigger.has-category-number{
  grid-template-columns:minmax(34px,48px) minmax(0,1fr) 44px;
}
.category-trigger.no-category-number{
  grid-template-columns:minmax(0,1fr) 44px;
}
.category-trigger.no-category-number .category-title-wrap{
  grid-column:1;
}
.category-trigger.no-category-number .category-chevron{
  grid-column:2;
}
.category-title-wrap{
  width:100%;
  min-width:0;
  max-width:none;
  overflow:visible;
}
.category-title-wrap strong,
.category-title-wrap small{
  display:block;
  width:100%;
  min-width:0;
  max-width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
@media(max-width:600px){
  .category-trigger.has-category-number{
    grid-template-columns:minmax(30px,34px) minmax(0,1fr) 39px;
  }
  .category-trigger.no-category-number{
    grid-template-columns:minmax(0,1fr) 39px;
  }
}
